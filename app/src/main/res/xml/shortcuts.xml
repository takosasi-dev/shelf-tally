<?xml version="1.0" encoding="utf-8"?>
<!-- FR-17: 決まった 2 つのショートカット。extra の名前と値は ui/nav/Routes.kt と同じにする。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutId="scan"
        android:shortcutLongLabel="@string/shortcut_scan_long"
        android:shortcutShortLabel="@string/shortcut_scan_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.takosasidev.shelftally.MainActivity"
            android:targetPackage="io.github.takosasidev.shelftally">
            <extra
                android:name="io.github.takosasidev.shelftally.DESTINATION"
                android:value="scan" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_cart"
        android:shortcutId="shopping"
        android:shortcutLongLabel="@string/shortcut_shopping_long"
        android:shortcutShortLabel="@string/shortcut_shopping_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.takosasidev.shelftally.MainActivity"
            android:targetPackage="io.github.takosasidev.shelftally">
            <extra
                android:name="io.github.takosasidev.shelftally.DESTINATION"
                android:value="shopping" />
        </intent>
    </shortcut>
</shortcuts>
